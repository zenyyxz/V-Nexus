{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 10808,
      "sniff": true,
      "sniff_override_destination": true,
      "sniff_protocols": [
        "tls",
        "http"
      ],
      "sniff_timeout_ms": 300
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "example-vless-server.com",
      "server_port": 443,
      "uuid": "27848739-7e62-4138-9fd3-098a63964b6b",
      "network": "tcp",
      "tls": {
        "enabled": true,
        "server_name": "example-vless-server.com",
        "insecure": false,
        "alpn": [
          "h2",
          "http/1.1"
        ]
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_cidr": [
          "127.0.0.0/8",
          "10.0.0.0/8",
          "192.168.0.0/16",
          "172.16.0.0/12"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          ".local",
          ".lan",
          ".internal"
        ],
        "outbound": "direct"
      },
      {
        "domain_keyword": [
          "ads",
          "tracking"
        ],
        "outbound": "block"
      }
    ],
    "final": "proxy"
  }
}
